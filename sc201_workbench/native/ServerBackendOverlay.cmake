# Keep the upstream checkout unchanged. Compile the same backend with only the
# outer response-envelope allowlist extended to the optional requestId field.
set(backend_source "${SC201_HOST_SOURCE}/src/security/ServerBackend.cpp")
set(backend_overlay "${RTT_WORKBENCH_OVERLAY}/ServerBackend.cpp")
file(READ "${backend_source}" backend_text)
set(old_fields [=[fields(object, rootResponse || serialResponse ? QStringList{"code", "message", "data", "requestId"} : QStringList{"code", "message", "data"});]=])
set(new_fields [=[fields(object, {"code", "message", "data", "requestId"});]=])
string(FIND "${backend_text}" "${old_fields}" old_location)
string(FIND "${backend_text}" "${new_fields}" new_location)
if(NOT old_location EQUAL -1)
  string(REPLACE "${old_fields}" "${new_fields}" backend_text "${backend_text}")
elseif(new_location EQUAL -1)
  message(FATAL_ERROR "ServerBackend response allowlist changed; review requestId integration")
endif()
file(WRITE "${backend_overlay}" "${backend_text}")

# ServerBackend belongs to the security static library, not the GUI sources.
# Replacing a GUI source alone would leave the original decoder in the DLL.
get_target_property(security_sources sc201_host_security SOURCES)
set(updated_security_sources)
set(backend_replacements 0)
foreach(source IN LISTS security_sources)
  if(NOT IS_ABSOLUTE "${source}")
    set(source "${SC201_HOST_SOURCE}/${source}")
  endif()
  if(source STREQUAL backend_source)
    set(source "${backend_overlay}")
    math(EXPR backend_replacements "${backend_replacements} + 1")
  endif()
  list(APPEND updated_security_sources "${source}")
endforeach()
if(NOT backend_replacements EQUAL 1)
  message(FATAL_ERROR "Expected exactly one ServerBackend source in sc201_host_security")
endif()
set_property(TARGET sc201_host_security PROPERTY SOURCES "${updated_security_sources}")
target_include_directories(sc201_host_security PRIVATE "${SC201_HOST_SOURCE}/src/security")
if(MSVC)
  target_compile_options(sc201_host_security PRIVATE /utf-8)
endif()
