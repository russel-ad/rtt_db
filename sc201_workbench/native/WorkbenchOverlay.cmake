# Add a narrow integration hook to build-local copies. The original checkout
# and its normal executable remain unchanged. Stop if its interface changes.
set(RTT_WORKBENCH_OVERLAY "${CMAKE_CURRENT_BINARY_DIR}/rtt_workbench_overlay")
file(MAKE_DIRECTORY "${RTT_WORKBENCH_OVERLAY}")
set(RTT_WORKBENCH_OVERLAY_FILES MainWindow.h MainWindow.cpp SecurityPanel.h SecurityPanel.cpp
  MlinkSession.cpp MlinkSessionOta.cpp BleLink.cpp BleWinrtGatt.h BleWinrtGatt.cpp)
foreach(name IN LISTS RTT_WORKBENCH_OVERLAY_FILES)
  configure_file("${SC201_HOST_SOURCE}/src/${name}" "${RTT_WORKBENCH_OVERLAY}/${name}" COPYONLY)
  file(READ "${RTT_WORKBENCH_OVERLAY}/${name}" contents)
  if(name STREQUAL "MainWindow.h" OR name STREQUAL "SecurityPanel.h")
    string(FIND "${contents}" "Q_OBJECT" found)
    if(found EQUAL -1)
      message(FATAL_ERROR "Cannot add batch OTA context hook to ${name}")
    endif()
    string(REPLACE "Q_OBJECT" "Q_OBJECT\n    friend class RttBatchOtaPanel;" contents "${contents}")
  elseif(name STREQUAL "SecurityPanel.cpp")
    set(guard "return !m_activeTitle.isEmpty() || m_waitingScan || m_waitingOta ||")
    string(FIND "${contents}" "${guard}" found)
    if(found EQUAL -1)
      message(FATAL_ERROR "SecurityPanel operation guard changed; review batch OTA integration")
    endif()
    string(REPLACE "${guard}" "return property(\"rttBatchOtaActive\").toBool() || !m_activeTitle.isEmpty() || m_waitingScan || m_waitingOta ||" contents "${contents}")
  endif()
  file(WRITE "${RTT_WORKBENCH_OVERLAY}/${name}" "${contents}")
endforeach()
include("${RTT_WORKBENCH_SOURCE}/SpeedOverlay.cmake")
